# ==============================================================================
# Study Buddy — Backend Environment Variables (Railway / Production / Local)
# ==============================================================================

# Application Port (automatically assigned by Railway as $PORT, defaults to 5000)
PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-32-byte-hex-string

# Allowed Frontend Origins for CORS (Vercel deployment URL and local development)
# For production, set this to your Vercel deployment URL: e.g. https://your-studybuddy.vercel.app
FRONTEND_URL=https://your-study-buddy-app.vercel.app,http://localhost:5173

# SQLite Database Location
# In local development: defaults to study_buddy.db
# In Railway production: set to /data/study_buddy.db after attaching a Persistent Volume mounted at /data
DATABASE_FILE=study_buddy.db

# ==============================================================================
# AI Provider Configuration (At least one provider required)
# ==============================================================================

# Default model provider to use ("gemma", "nemotron", or "glm")
DEFAULT_MODEL=gemma

# OpenRouter API (Google Gemma 4 26B A4B)
# Get your API key from OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_TIMEOUT=60

# NVIDIA API (Nemotron / Llama / etc.)
# Get your key from NVIDIA Build: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning:free

# GLM / OpenRouter API
GLM_API_KEY=your_glm_or_openrouter_key_here
GLM_MODEL=z-ai/glm-5.2:free
GLM_VISION_MODEL=z-ai/glm-5.2:free

# ==============================================================================
# Firebase Admin SDK Configuration (Server-Side Token Verification)
# Choose ONE of the following methods for Railway production:
# ==============================================================================

# Option A (Recommended for Railway): Paste entire contents of serviceAccountKey.json as a single-line string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: Individual environment credentials
FIREBASE_PROJECT_ID=studyassistant-26fb6
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@studyassistant-26fb6.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C (Local Dev): Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

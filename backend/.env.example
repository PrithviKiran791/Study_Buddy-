# ==============================================================================
# Study Buddy — Backend Environment Variables (Docker / Container Hosts)
# ==============================================================================

# Application Port & Worker Settings
PORT=5000
GUNICORN_WORKERS=2
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-random-32-byte-hex-string

# Allowed Frontend Origins for CORS (Cloudflare Pages deployment URL and local development)
FRONTEND_URL=https://study-buddy.pages.dev,http://localhost:5173

# SQLite Database Location
# In local container: /data/study_buddy.db (mounted via Docker volume /data)
DATABASE_FILE=/data/study_buddy.db

# ==============================================================================
# AI Provider Configuration (Server-Side Secrets — NEVER expose to frontend)
# ==============================================================================

# Default model provider to use ("gemini", "nemotron", or "glm")
DEFAULT_MODEL=gemini

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter / NVIDIA API (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_key_here
NVIDIA_API_KEY=your_nvidia_or_openrouter_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning:free

# GLM API
GLM_API_KEY=your_glm_or_openrouter_key_here
GLM_MODEL=z-ai/glm-5.2:free
GLM_VISION_MODEL=z-ai/glm-5.2:free

# ==============================================================================
# Firebase Admin SDK Configuration (Server-Side Token Verification)
# ==============================================================================

FIREBASE_PROJECT_ID=studyassistant-26fb6
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
